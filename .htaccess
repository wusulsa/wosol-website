# ============================================================
#  وُسُل — إعدادات الخادم
# ============================================================

# ── تحويل كل الزوار إلى HTTPS ───────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── ضغط الملفات النصية لتسريع التحميل ───────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── تخزين مؤقت للصور والخطوط (الملفات المتغيرة محمية برقم إصدار) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 1 month"
  ExpiresByType image/webp       "access plus 1 month"
  ExpiresByType image/jpeg       "access plus 1 month"
  ExpiresByType font/woff2       "access plus 1 month"
  ExpiresByType font/ttf         "access plus 1 month"
  ExpiresByType image/svg+xml    "access plus 1 month"
  ExpiresByType image/x-icon     "access plus 1 month"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ── ترميز UTF-8 للنصوص العربية ──────────────────────────────
AddDefaultCharset UTF-8

# ── منع عرض محتويات المجلدات ────────────────────────────────
Options -Indexes

# ── clean-urls: روابط احترافية بلا امتداد .html ─────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # توحيد النطاق: wosol.net  ->  www.wosol.net
  RewriteCond %{HTTP_HOST} ^wosol\.net$ [NC]
  RewriteRule ^(.*)$ https://www.wosol.net/$1 [R=301,L]

  # /index.html  ->  /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /register.html  ->  /register
  RewriteCond %{THE_REQUEST} \s/+register\.html[\s?] [NC]
  RewriteRule ^ /register [R=301,L]

  # Preserve old student links while focusing the university landing page.
  RewriteRule ^student-transport-jeddah(?:\.html)?/?$ /king-abdulaziz-university-transport [R=301,L]

  # Canonical, crawlable service URLs. English pages use real directories.
  RewriteCond %{THE_REQUEST} \s/+(king-abdulaziz-university-transport|employee-transport-jeddah|employee-transport-riyadh|employee-transport-makkah|employee-transport-madinah|employee-transport-dammam|corporate-transport-saudi-arabia|workforce-project-transport|private-day-trips|event-conference-transport|airport-hotel-transfers|intercity-group-transport|tourism-transport|umrah-visitor-transport|executive-vip-transport|vehicle-rental-without-driver|driver-only-services)\.html[\s?] [NC]
  RewriteRule ^(king-abdulaziz-university-transport|employee-transport-jeddah|employee-transport-riyadh|employee-transport-makkah|employee-transport-madinah|employee-transport-dammam|corporate-transport-saudi-arabia|workforce-project-transport|private-day-trips|event-conference-transport|airport-hotel-transfers|intercity-group-transport|tourism-transport|umrah-visitor-transport|executive-vip-transport|vehicle-rental-without-driver|driver-only-services)\.html$ /$1 [R=301,L]
  RewriteRule ^(king-abdulaziz-university-transport|employee-transport-jeddah|employee-transport-riyadh|employee-transport-makkah|employee-transport-madinah|employee-transport-dammam|corporate-transport-saudi-arabia|workforce-project-transport|private-day-trips|event-conference-transport|airport-hotel-transfers|intercity-group-transport|tourism-transport|umrah-visitor-transport|executive-vip-transport|vehicle-rental-without-driver|driver-only-services)/?$ $1.html [L]

  # /register يعرض register.html داخلياً
  RewriteRule ^register/?$ register.html [L]
</IfModule>

# Legacy company profile -> approved 2026 profile (2026-10-26)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^wp-content/uploads/2022/04/بروفايل-لموقع-وسل-النقل-جدة-مكة-2022\.pdf$ https://www.wosol.net/assets/RUH-Jed-AR.EN-2026-06.pdf [R=301,L]
</IfModule>

