# ============================================================
#  وُسُل — إعدادات الخادم
# ============================================================

# ── تحويل كل الزوار إلى HTTPS ───────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── ضغط الملفات النصية لتسريع التحميل ───────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── تخزين مؤقت للصور والخطوط (الملفات المتغيرة محمية برقم إصدار) ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 1 month"
  ExpiresByType image/svg+xml    "access plus 1 month"
  ExpiresByType image/x-icon     "access plus 1 month"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ── ترميز UTF-8 للنصوص العربية ──────────────────────────────
AddDefaultCharset UTF-8

# ── منع عرض محتويات المجلدات ────────────────────────────────
Options -Indexes

# ── clean-urls: روابط احترافية بلا امتداد .html ─────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html  ->  /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /register.html  ->  /register
  RewriteCond %{THE_REQUEST} \s/+register\.html[\s?] [NC]
  RewriteRule ^ /register [R=301,L]

  # /register يعرض register.html داخلياً
  RewriteRule ^register/?$ register.html [L]
</IfModule>
